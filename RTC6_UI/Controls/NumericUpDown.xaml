<UserControl x:Class="RTC6_UI.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="20"
             MinHeight="20"
             MinWidth="50"
             Focusable="False"
             UseLayoutRounding="True">

    <Border Background="White" BorderBrush="#B7B7B7" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ValueTextBox"
                     Grid.Column="0"
                     Height="Auto"
                     MinHeight="0"
                     Margin="0"
                     Padding="3,0,1,0"
                     FontSize="11"
                     BorderThickness="0"
                     Background="White"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Left"
                     PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                     LostKeyboardFocus="ValueTextBox_LostKeyboardFocus"
                     MouseWheel="ValueTextBox_MouseWheel" />

            <Grid Grid.Column="1" Background="#F4F4F4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <RepeatButton Grid.Row="0"
                              Content="▲"
                              FontSize="5"
                              Padding="0"
                              Margin="0"
                              BorderThickness="0,0,0,1"
                              BorderBrush="#C8C8C8"
                              Background="Transparent"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Delay="350"
                              Interval="70"
                              Focusable="False"
                              Click="IncreaseButton_Click" />

                <RepeatButton Grid.Row="1"
                              Content="▼"
                              FontSize="5"
                              Padding="0"
                              Margin="0"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Delay="350"
                              Interval="70"
                              Focusable="False"
                              Click="DecreaseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>