<Window x:Class="RTC6_UI.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RTC6_UI.Controls"
        xmlns:converters="clr-namespace:RTC6_UI.Converters"
        xmlns:settings="clr-namespace:RTC6_UI.Settings"
        Title="설정"
        Width="650"
        Height="850"
        MinWidth="620"
        MinHeight="600"
        FontFamily="맑은 고딕"
        FontSize="11"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- 전체 입력 항목 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,4" />
        </Style>

        <!-- 왼쪽 항목 이름 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3,2,12,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 구역 제목 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,10,0,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666666" />
        </Style>

        <!-- 설명 문구 -->
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,7" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#D52B1E" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 스크롤바 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <converters:HexUInt32Converter x:Key="HexUInt32Converter" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="시스템 설정 (H/W)" FontSize="10" >
                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,2,14,8">

                        <!-- RTC6 파일 및 스캔 필드 -->
                        <TextBlock Text="── RTC6 및 스캔 필드 ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="RTC6 보드 번호:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <controls:NumericUpDown Grid.Row="0" Grid.Column="2" Width="40" HorizontalAlignment="Left"
                                                    Value="{Binding BoardNumber}" Minimum="1" Maximum="16"
                                                    Increment="1" DecimalPlaces="0" Margin="0,4,0,3" />

                            <TextBlock Grid.Row="1" Text="RTC6 파일 폴더:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />

                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                <TextBox x:Name="Rtc6FilesFolderTextBox" Width="230" Height="20"
                                         IsReadOnly="True"
                                         Text="{Binding Rtc6FilesFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Width="28" Height="20" Margin="6,3,0,2"
                                        Content="..."
                                        Style="{StaticResource RoundButton}"
                                        Background="White"
                                        Click="BrowseProgramFolderButton_Click" />

                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="보정 파일명:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <TextBox Grid.Row="2" Grid.Column="2" Width="160" Height="20" HorizontalAlignment="Left" Margin="0,2,0,2"
                                     Text="{Binding CorrectionFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Text="Bits/mm:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <controls:NumericUpDown Grid.Row="3" Grid.Column="2" Width="100" HorizontalAlignment="Left"
                                                    Value="{Binding BitsPerMillimeter}" Minimum="1" Maximum="1000000"
                                                    Increment="1" DecimalPlaces="1" Margin="0,4,0,3" />

                            <TextBlock Grid.Row="4" Text="필드 크기 [mm]:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <controls:NumericUpDown Grid.Row="4" Grid.Column="2" Width="85" HorizontalAlignment="Left"
                                                    Value="{Binding FieldSizeMillimeter}" Minimum="1" Maximum="1000"
                                                    Increment="1" DecimalPlaces="1" Margin="0,5,0,4" />
                        </Grid>

                        <StackPanel Margin="160,2,0,0" Orientation="Horizontal">
                            <CheckBox Content="Flip Scan X" IsChecked="{Binding FlipScanX}" />
                            <CheckBox Margin="18,4,0,4" Content="Flip Scan Y" IsChecked="{Binding FlipScanY}" />
                        </StackPanel>

                        <!-- 이송축 및 엔코더 -->
                        <TextBlock Text="── 이송축 및 엔코더 ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="물리 이송축:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="FeedAxisComboBox" Grid.Row="0" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding FeedAxis}" />

                            <TextBlock Grid.Row="1" Text="이송 방향:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="FeedDirectionComboBox" Grid.Row="1" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding FeedDirection}" />

                            <TextBlock Grid.Row="2" Text="Fly 축 교환:" Style="{StaticResource LabelStyle}" />
                            <CheckBox Grid.Row="2" Grid.Column="1" Content="FeedAxis ↔ _set_fly_x/y"
                                      IsChecked="{Binding SwapFlyAxis}" />

                            <TextBlock Grid.Row="3" Text="엔코더 [pulses/mm]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                                    Value="{Binding EncoderPulsesPerMillimeter}"
                                                    Minimum="1" Maximum="1000000"
                                                    Increment="1" DecimalPlaces="1" />

                            <TextBlock Grid.Row="4" Text="엔코더 극성:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="EncoderPolarityComboBox" Grid.Row="4" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding EncoderPolarity}" />
                        </Grid>

                        <!-- SCANahead -->
                        <TextBlock Text="── SCANahead ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                                <RowDefinition Height="27" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CornerScale [%]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Width="75" HorizontalAlignment="Left"
                                                    Value="{Binding CornerScalePercent}"
                                                    Minimum="1" Maximum="100"
                                                    Increment="1" DecimalPlaces="0" />

                            <TextBlock Grid.Row="1" Text="EndScale [%]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Width="75" HorizontalAlignment="Left"
                                                    Value="{Binding EndScalePercent}"
                                                    Minimum="1" Maximum="100"
                                                    Increment="1" DecimalPlaces="0" />

                            <TextBlock Grid.Row="2" Text="AccScale [%]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Width="75" HorizontalAlignment="Left"
                                                    Value="{Binding AccScalePercent}"
                                                    Minimum="1" Maximum="100"
                                                    Increment="1" DecimalPlaces="0" />

                            <TextBlock Grid.Row="3" Text="LaserShiftOn [1/64µs]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Width="85" HorizontalAlignment="Left"
                                                    Value="{Binding LaserShiftOn64}"
                                                    Minimum="-100000" Maximum="100000"
                                                    Increment="1" DecimalPlaces="0" />

                            <TextBlock Grid.Row="4" Text="LaserShiftOff [1/64µs]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Width="85" HorizontalAlignment="Left"
                                                    Value="{Binding LaserShiftOff64}"
                                                    Minimum="-100000" Maximum="100000"
                                                    Increment="1" DecimalPlaces="0" />
                        </Grid>

                        <!-- Advanced OTF -->
                        <TextBlock Text="── Advanced OTF ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Text="기울어짐 보정 사용:" Style="{StaticResource LabelStyle}" />
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="이송방향 선형 기울어짐 보정"
                                      IsChecked="{Binding UseFeedDirectionSkewCompensation}" />

                            <TextBlock Grid.Row="1" Text="기울어짐 보정 [%]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                    Value="{Binding FeedDirectionSkewPercent}"
                                                    Minimum="-100" Maximum="100"
                                                    Increment="0.001" DecimalPlaces="3" />

                            <TextBlock Grid.Row="2" Text="OTF 보정 모드:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="MotionCompensationComboBox" Grid.Row="2" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding MotionCompensation}" />

                            <TextBlock Grid.Row="3" Text="RTC Fly API:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="FlyActivationComboBox" Grid.Row="3" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding FlyActivation}" />

                            <TextBlock Grid.Row="4" Text="Fly 보정 방향:" Style="{StaticResource LabelStyle}" />
                            <CheckBox Grid.Row="4" Grid.Column="1" Content="Fly 보정 방향 반전"
                                      IsChecked="{Binding InvertFly}" />

                            <TextBlock Grid.Row="5" Text="Fly 스케일 보정 [%]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="5" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                    Value="{Binding FlyScaleCorrectionPercent}"
                                                    Minimum="-99.999" Maximum="500"
                                                    Increment="0.001" DecimalPlaces="3" />
                        </Grid>

                        <TextBlock Margin="160,2,0,8"
                                   Text="Advanced: 기본값 0/Off를 유지하고 방향 및 엔코더 설정 확인 후 사용하세요."
                                   Style="{StaticResource DescriptionStyle}" />

                        <!-- I/O 및 레이저 -->
                        <TextBlock Text="── I/O 및 안전 ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="운영 모드:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="OperationModeComboBox" Grid.Row="0" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding OperationMode}" />

                            <TextBlock Grid.Row="1" Text="DONE 포트 마스크:" Style="{StaticResource LabelStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" 
                                     Text="{Binding DonePortMask, Mode=TwoWay,
                                                 Converter={StaticResource HexUInt32Converter},
                                                 UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="2" Text="엔코더 타임아웃 [ms]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Width="95" HorizontalAlignment="Left"
                                                    Value="{Binding EncoderTimeoutMilliseconds}"
                                                    Minimum="100" Maximum="600000"
                                                    Increment="100" DecimalPlaces="0" />

                            <TextBlock Grid.Row="3" Text="레이저 모드:" Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="LaserModeComboBox" Grid.Row="3" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" SelectedItem="{Binding LaserMode}" />

                            <TextBlock Grid.Row="4" Text="주파수 [kHz]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Width="95" HorizontalAlignment="Left"
                                                    Value="{Binding LaserFrequencyKilohertz}"
                                                    Minimum="0.1" Maximum="1000"
                                                    Increment="0.1" DecimalPlaces="1" />

                            <TextBlock Grid.Row="5" Text="펄스폭 [µs]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="5" Grid.Column="1" Width="85" HorizontalAlignment="Left"
                                                    Value="{Binding LaserPulseWidthMicroseconds}"
                                                    Minimum="0.1" Maximum="10000"
                                                    Increment="0.1" DecimalPlaces="1" />
                        </Grid>

                        <!-- Delay -->
                        <TextBlock Text="── Delay ──" Style="{StaticResource SectionTitleStyle}" />

                        <CheckBox x:Name="AutoDelayCheckBox"
                                  Margin="160,3,0,5"
                                  Content="Auto Delay 사용"
                                  IsChecked="{Binding UseAutoDelay}"
                                  Click="AutoDelayCheckBox_Changed" />

                        <StackPanel x:Name="ManualDelayPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Laser On Delay [1/64µs]:" Style="{StaticResource LabelStyle}" />
                                <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                        Value="{Binding LaserOnDelay64}"
                                                        Minimum="-100000" Maximum="100000"
                                                        Increment="1" DecimalPlaces="0" />

                                <TextBlock Grid.Row="1" Text="Laser Off Delay [1/64µs]:" Style="{StaticResource LabelStyle}" />
                                <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                        Value="{Binding LaserOffDelay64}"
                                                        Minimum="0" Maximum="100000"
                                                        Increment="1" DecimalPlaces="0" />

                                <TextBlock Grid.Row="2" Text="Scanner Mark Delay [µs]:" Style="{StaticResource LabelStyle}" />
                                <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                        Value="{Binding ScannerMarkDelayMicroseconds}"
                                                        Minimum="0" Maximum="100000"
                                                        Increment="10" DecimalPlaces="0" />

                                <TextBlock Grid.Row="3" Text="Scanner Jump Delay [µs]:" Style="{StaticResource LabelStyle}" />
                                <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                        Value="{Binding ScannerJumpDelayMicroseconds}"
                                                        Minimum="0" Maximum="100000"
                                                        Increment="10" DecimalPlaces="0" />

                                <TextBlock Grid.Row="4" Text="Scanner Polygon Delay [µs]:" Style="{StaticResource LabelStyle}" />
                                <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                        Value="{Binding ScannerPolygonDelayMicroseconds}"
                                                        Minimum="0" Maximum="100000"
                                                        Increment="10" DecimalPlaces="0" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="모델 파라미터"
                     DataContext="{Binding EditingModelSettings, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10">
                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,2,14,8">

                        <!-- 속도 및 패턴 피치 -->
                        <Grid>
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="마킹 속도 [mm/s]:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                                    Value="{Binding MarkingSpeedMillimeterPerSecond, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100000" Increment="10" DecimalPlaces="0" Margin="0,4,0,5" />

                            <TextBlock Grid.Row="1" Text="점프 속도 [mm/s]:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                                    Value="{Binding JumpSpeedMillimeterPerSecond, Mode=TwoWay}"
                                                    Minimum="1" Maximum="100000" Increment="10" DecimalPlaces="0" Margin="0,5,0,4" />

                            <TextBlock Grid.Row="2" Text="패턴 피치 [mm]:" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="3,0,12,0" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1"
                                                    Value="{Binding PatternPitchMillimeter, Mode=TwoWay}"
                                                    Minimum="0.001" Maximum="100000" Increment="0.1" DecimalPlaces="2" Margin="0,4,0,5" HorizontalAlignment="Left" Width="110" />
                        </Grid>

                        <!-- 롤 및 구간 길이 -->
                        <TextBlock Text="── 롤 / 구간 길이 ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="롤 전체 길이 [mm]:" Style="{StaticResource LabelStyle}" Margin="3,0,12,0" Height="15" />
                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1"
                                                    Value="{Binding RollTotalLengthMillimeter, Mode=TwoWay}"
                                                    Minimum="0" Maximum="10000000" Increment="1" DecimalPlaces="1" Margin="0,4,0,5" HorizontalAlignment="Left" Width="110" />

                            <TextBlock Grid.Row="1" Text="앞 커팅 길이 [mm]:" Style="{StaticResource LabelStyle}" Margin="3,0,12,0" Height="15" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Width="109" HorizontalAlignment="Left"
                                                    Value="{Binding FrontCutLengthMillimeter, Mode=TwoWay}"
                                                    Minimum="0" Maximum="10000000" Increment="1" DecimalPlaces="1" Margin="0,5,0,4" />

                            <TextBlock Grid.Row="2" Text="뒤 커팅 길이 [mm]:" Style="{StaticResource LabelStyle}" Margin="3,0,12,0" Height="15" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Width="109" HorizontalAlignment="Left"
                                                    Value="{Binding RearCutLengthMillimeter, Mode=TwoWay}"
                                                    Minimum="0" Maximum="10000000" Increment="1" DecimalPlaces="1" Margin="0,4,0,5" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="속도 검증" Margin="3,2,0,0" Foreground="#159447" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="패턴 구간: -" Margin="4,2,0,0" Foreground="#4A38B8" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="패턴 횟수: -" Margin="4,2,0,0" Foreground="#4A38B8" FontWeight="SemiBold" />
                        </Grid>

                        <!-- 커팅 위치 -->
                        <TextBlock Text="── 커팅 위치 ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="커팅 기준점:" Style="{StaticResource LabelStyle}" Margin="3,7,12,0" Height="15" VerticalAlignment="Top" />
                            <ComboBox Grid.Column="1"
                                      SelectedValuePath="Tag" SelectedValue="{Binding CuttingReference, Mode=TwoWay}" Height="21" VerticalAlignment="Center" HorizontalAlignment="Left" Width="230">
                                <ComboBoxItem Content="바닥/좌측 (NegativeSide)" Tag="{x:Static settings:CuttingReferencePoint.NegativeSide}" />
                                <ComboBoxItem Content="중심 (Center)" Tag="{x:Static settings:CuttingReferencePoint.Center}" />
                                <ComboBoxItem Content="상단/우측 (PositiveSide)" Tag="{x:Static settings:CuttingReferencePoint.PositiveSide}" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="커팅 라인 오프셋 [mm]:" Style="{StaticResource LabelStyle}" Margin="3,0,12,0" Height="15" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1"
                                                    Value="{Binding CuttingLineOffsetMillimeter, Mode=TwoWay}"
                                                    Minimum="-1000" Maximum="1000" Increment="0.1" DecimalPlaces="2" Margin="0,5,0,4" HorizontalAlignment="Left" Width="110" />

                            <TextBlock Grid.Row="2" Text="파크 오프셋 [mm]:" Style="{StaticResource LabelStyle}" Margin="3,0,12,0" Height="15" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1"
                                                    Value="{Binding ParkOffsetMillimeter, Mode=TwoWay}"
                                                    Minimum="-1000" Maximum="1000" Increment="0.1" DecimalPlaces="2" Margin="0,5,0,4" HorizontalAlignment="Left" Width="110" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="절대값: -" Margin="3,2,0,0" Foreground="#159447" FontWeight="SemiBold" />
                        </Grid>

                        <!-- 패턴 오프셋 -->
                        <TextBlock Text="── 패턴 오프셋 ──" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="패턴 오프셋 X [mm]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                                    Value="{Binding PatternOffsetXMillimeter, Mode=TwoWay}"
                                                    Minimum="-1000" Maximum="1000" Increment="1" DecimalPlaces="3" Margin="0,4,0,5" />

                            <TextBlock Grid.Row="1" Text="패턴 오프셋 Y [mm]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                                                    Value="{Binding PatternOffsetYMillimeter, Mode=TwoWay}"
                                                    Minimum="-1000" Maximum="1000" Increment="1" DecimalPlaces="3" Margin="0,5,0,4" />

                            <TextBlock Grid.Row="2" Text="도안 X 배율:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                    Value="{Binding PatternScaleX, Mode=TwoWay}"
                                                    Minimum="0.001" Maximum="1000" Increment="0.001" DecimalPlaces="3" Margin="0,4,0,5" />

                            <TextBlock Grid.Row="3" Text="도안 Y 배율:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                    Value="{Binding PatternScaleY, Mode=TwoWay}"
                                                    Minimum="0.001" Maximum="1000" Increment="0.001" DecimalPlaces="3" Margin="0,5,0,4" />

                            <TextBlock Grid.Row="4" Text="이송 속도 [mm/s]:" Style="{StaticResource LabelStyle}" />
                            <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                    Value="{Binding MaterialFeedSpeedMillimeterPerSecond, Mode=TwoWay}"
                                                    Minimum="0" Maximum="100000" Increment="10" DecimalPlaces="0" Margin="0,4,0,5" />
                        </Grid>

                        <!-- OTF 경로 설정 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="390" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="29" />
                                <RowDefinition Height="29" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="OTF 경로 모드:" Style="{StaticResource LabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      SelectedValuePath="Tag" SelectedValue="{Binding PathMode, Mode=TwoWay}" Margin="0,7,0,7" HorizontalAlignment="Left" Width="230">
                                <ComboBoxItem Content="Standard" Tag="{x:Static settings:OtfPathMode.Standard}" />
                                <ComboBoxItem Content="FeedOptimized (고속 OTF 권장)" Tag="{x:Static settings:OtfPathMode.FeedOptimized}" />
                            </ComboBox>

                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Stroke reverse 허용" IsChecked="{Binding AllowStrokeReverse, Mode=TwoWay}" />
                            <CheckBox Grid.Row="2" Grid.Column="1" Content="패턴 경계 연속 mark 허용(향후 장비 검증 후 사용)"
                                      IsChecked="{Binding AllowContinuousBoundaryMark, Mode=TwoWay}" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="TEST 모드">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                               Foreground="#777777" Text="TEST 모드 화면 구현 영역" />
                </Grid>
            </TabItem>


        </TabControl>

        <!-- 확인 및 취소 -->
        <StackPanel Grid.Row="1" Margin="0,10,2,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="78" Height="28" Margin="4" Content="확인"
                    IsDefault="True" Click="ConfirmButton_Click" />

            <Button Width="78" Height="28" Margin="4" Content="취소"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>